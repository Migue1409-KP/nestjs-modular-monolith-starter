# Database
DB_HOST=...
DB_PORT=...
DB_USERNAME=...
DB_PASSWORD=...
DB_NAME=...
# DB_SSL — set to true if your database provider requires SSL (default: false)
DB_SSL=false
# With DB_SSL=true the server certificate is verified. For a private/self-signed CA provide it as PEM
# (newlines as 
) in DB_SSL_CA. DB_SSL_REJECT_UNAUTHORIZED=false disables verification: last resort only.
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=true

# App Configuration
NODE_ENV=...
NAME_APP=...
PORT=...
API_PREFIX=...
HOST=...
DOMAIN=...
# COOKIE_CROSS_SITE — true when the frontend is on another site/subdomain (SameSite=None; Secure). DOMAIN enables cross-subdomain cookies
COOKIE_CROSS_SITE=false

# Variables set to "..." or left empty count as missing. Required everywhere: DB_*, DATABASE_URL, secrets, API_KEY, FRONTEND_URL.
# GOOGLE_*, AWS_* and R2_* are required only when NODE_ENV is production or staging.

# HTTP hardening (all optional)
# TRUST_PROXY — hops of reverse proxy in front of the app (e.g. 1 on Railway/Fly) so rate limiting uses the real client IP
# TRUST_PROXY=1
# BODY_LIMIT — max JSON/urlencoded body size (default 1mb)
# BODY_LIMIT=1mb
# Rate limiting per client IP: general bucket and stricter bucket for /auth (defaults: 100 and 10 per 60000 ms)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100
# THROTTLE_AUTH_LIMIT=10

# Winston Logging
LOG_LEVEL=...

# Better Auth
# Secrets are validated at startup (the app will not boot without them). Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET and MAGIC_LINK_SECRET: min. 32 chars; API_KEY: min. 16 chars
BETTER_AUTH_SECRET=...
# BETTER_AUTH_URL — optional public origin (no path), e.g. https://api.example.com. Defaults to HOST:PORT
# BETTER_AUTH_URL=http://localhost:3000
MAGIC_LINK_TOKEN_LENGTH=...
MAGIC_LINK_SECRET=...

# DB (tuya, ya existente para TypeORM) – Better Auth usará su propio esquema/migración
DATABASE_URL=...

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# Optional extra OAuth scopes, comma separated (default: only openid, email, profile).
# GOOGLE_SCOPES=https://www.googleapis.com/auth/user.birthday.read

# Api key
API_KEY=...

# AWS Configuration
AWS_REGION=...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# AWS SES Configuration
AWS_SES_SENDER=...

# FRONTEND_URL — single origin or comma-separated list, e.g. http://localhost:3001,https://app.example.com
FRONTEND_URL=...
LANDING_PAGE_URL=...

# Cloudflare R2 Storage
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=...
R2_PUBLIC_URL=...
R2_PRESIGN_EXPIRES_IN=300
