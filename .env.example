# Database
DB_HOST=...
DB_PORT=...
DB_USERNAME=...
DB_PASSWORD=...
DB_NAME=...
# DB_SSL — set to true if your database provider requires SSL (default: false)
DB_SSL=false

# App Configuration
NODE_ENV=...
NAME_APP=...
PORT=...
API_PREFIX=...
HOST=...
DOMAIN=...
# COOKIE_CROSS_SITE — true when the frontend is on another site/subdomain (SameSite=None; Secure). DOMAIN enables cross-subdomain cookies
COOKIE_CROSS_SITE=false

# Winston Logging
LOG_LEVEL=...

# Better Auth
BETTER_AUTH_SECRET=...
MAGIC_LINK_TOKEN_LENGTH=...
MAGIC_LINK_SECRET=...

# DB (tuya, ya existente para TypeORM) – Better Auth usará su propio esquema/migración
DATABASE_URL=...

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Api key
API_KEY=...

# AWS Configuration
AWS_REGION=...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# AWS SES Configuration
AWS_SES_SENDER=...

# FRONTEND_URL — single origin or comma-separated list, e.g. http://localhost:3001,https://app.example.com
FRONTEND_URL=...
LANDING_PAGE_URL=...

# Cloudflare R2 Storage
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=...
R2_PUBLIC_URL=...
R2_PRESIGN_EXPIRES_IN=300