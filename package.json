{
  "name": "nestjs-modular-monolith-starter",
  "version": "1.0.1",
  "description": "NestJS modular monolith starter with Better Auth, role-based authorization, TypeORM, Zod, Winston and Scalar API docs",
  "author": "Miguel Mosquera",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Migue1409-KP/nestjs-modular-monolith-starter.git"
  },
  "bugs": {
    "url": "https://github.com/Migue1409-KP/nestjs-modular-monolith-starter/issues"
  },
  "homepage": "https://github.com/Migue1409-KP/nestjs-modular-monolith-starter#readme",
  "engines": {
    "node": ">=22.12.0 <23.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --forceExit",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/core/database/data-source.ts --pretty",
    "migration:run": "npm run typeorm -- migration:run -d src/core/database/data-source.ts",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/core/database/data-source.js",
    "migration:revert": "npm run typeorm -- migration:revert -d src/core/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/core/database/seeders/run-seeders.ts",
    "auth:generate": "npx auth generate --config src/auth/better-auth.cli.ts",
    "auth:migrate": "npx auth migrate --config src/auth/better-auth.cli.ts",
    "sonar": "sonar-scanner",
    "sonar:cov": "npm run test:cov && sonar-scanner",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/client-ses": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.1076.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.3",
    "@scalar/nestjs-api-reference": "^1.0.31",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "axios": "^1.20.0",
    "better-auth": "^1.7.12",
    "dayjs": "^1.11.20",
    "helmet": "^8.3.0",
    "js-yaml": "^4.1.0",
    "mime-types": "^3.0.2",
    "nest-winston": "^1.9.4",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.19.18",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.12",
    "auth": "^1.7.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "^16.3.0",
    "prettier": "^3.0.0",
    "sonarqube-scanner": "^4.3.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@thallesp/nestjs-better-auth$": "<rootDir>/../test/mocks/nestjs-better-auth.ts",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!main.ts",
      "!**/*.module.ts",
      "!auth/better-auth.cli.ts",
      "!core/database/data-source.ts",
      "!core/database/migrations/**",
      "!core/database/seeders/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(@noble|jose|@better-auth)/)"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 65,
        "functions": 70,
        "lines": 80
      }
    }
  },
  "overrides": {
    "lodash": "^4.18.1",
    "ws": "^8.22.0",
    "@nestjs/swagger": {
      "js-yaml": "^5.5.0"
    },
    "@graphql-tools/utils": "^13.1.3"
  }
}
