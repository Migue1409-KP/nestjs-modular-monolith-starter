{
  "name": "nestjs-modular-template",
  "version": "1.0.0",
  "description": "NestJS Modular Monolith Template with JWT Auth, TypeORM, Zod, Winston and ExpressJS",
  "author": "Your Name",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0 <23.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate src/core/database/migrations/$npm_config_name -d src/core/database/data-source.ts --pretty",
    "migration:run": "npm run typeorm -- migration:run -d src/core/database/data-source.ts",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/core/database/data-source.js",
    "migration:revert": "npm run typeorm -- migration:revert -d src/core/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/core/database/seeders/run-seeders.ts",
    "auth:generate": "npx auth generate --config src/auth/better-auth.cli.ts",
    "auth:migrate": "npx auth migrate --config src/auth/better-auth.cli.ts",
    "sonar": "sonar-scanner",
    "sonar:cov": "npm run test:cov && sonar-scanner",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/client-ses": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.1076.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@scalar/nestjs-api-reference": "^1.0.31",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "better-auth": "^1.7.12",
    "dayjs": "^1.11.20",
    "js-yaml": "^4.1.0",
    "mime-types": "^3.0.2",
    "nest-winston": "^1.9.4",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.19.18",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "auth": "^1.7.12",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "^16.3.0",
    "prettier": "^3.0.0",
    "sonarqube-scanner": "^4.3.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@thallesp/nestjs-better-auth$": "<rootDir>/../test/mocks/nestjs-better-auth.ts",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(@noble|jose|@better-auth)/)"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 25,
        "branches": 20,
        "functions": 15,
        "lines": 24
      }
    }
  }
}
